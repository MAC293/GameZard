<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GameZard.Views.EmulatorMainView">

    <ScrollViewer Margin="24,0,24,0">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Width="65" Height="65" Margin="0,0,16,0"/>
                <TextBlock Text="ePSXe" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="↻" Width="32" Height="32" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Image Width="80" Height="80" Margin="0,0,16,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <TextBlock Text="Backup Mode" FontSize="32" VerticalAlignment="Center"/>
                <RadioButton Content="Automatically" GroupName="BackupMode" FontSize="28" Margin="80,0,0,0" VerticalAlignment="Center"/>
                <RadioButton Content="Manually" GroupName="BackupMode" FontSize="28" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
            </StackPanel>

            <TextBlock Text="From" FontSize="28" Margin="0,24,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox Width="400" FontSize="20" Text="..."/>
                <Button Content="Browse" Width="100" Height="40" Margin="16,0,0,0"/>
            </StackPanel>

            <TextBlock Text="To" FontSize="28" Margin="0,24,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox Width="400" FontSize="20" Text="..."/>
                <Button Content="Browse" Width="100" Height="40" Margin="16,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Last Save: 01/04/2021 at 13:00/01:00 PM" FontSize="22" Margin="0,24,0,0"/>
        </StackPanel>
    </ScrollViewer>

</UserControl>
