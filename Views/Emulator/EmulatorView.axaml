<Window 
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="clr-namespace:GameZard.Views"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="GameZard.Views.EmulatorView"
		Title="Emulator"
		Width="1150" Height="510">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="270"/>
			<ColumnDefinition Width="5"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Top bar: EmulatorSelectorView (left), EmulatorOptionsView (right) -->
		<Border Grid.ColumnSpan="3" Grid.Row="0" Background="White" BorderBrush="Black" BorderThickness="0,0,0,2">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="270"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<!-- Emulator selector (left) -->
				<views:EmulatorSelectorView Grid.Column="0"/>
				<!-- Emulator options (right/top bar) -->
				<views:EmulatorOptionsView Grid.Column="1"/>
			</Grid>
		</Border>

		<!-- Sidebar: EmulatorListView -->
		<Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,2,0" Background="White">
			<views:EmulatorListView />
		</Border>

		<!-- Vertical separator -->
		<Border Grid.Row="1" Grid.Column="1" Background="Black"/>

		<!-- Main content area: EmulatorMainView -->
		<Border Grid.Row="1" Grid.Column="2" Background="White">
			<views:EmulatorMainView />
		</Border>
	</Grid>
</Window>